# Demo mode: works with NO other keys set. Fake users, canned responses, simulate button.
NEXT_PUBLIC_DEMO_MODE=true

# Firebase (client, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only, only to verify ID tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Tiger Data (server only). Postgres connection string from Tiger Cloud.
DATABASE_URL=

# Google (server only)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
GOOGLE_ROUTES_API_KEY=
# Optional. Places API (New): real photos, rating and hours on restaurant pages.
# Without it, pages use the restaurant website's preview image.
GOOGLE_PLACES_API_KEY=
# Optional. Yelp Places (Fusion) API key: photos for restaurants we have none for.
# Looked up live and cached in memory only (Yelp forbids storing content over 24 h).
YELP_API_KEY=

# MBTA V3 (server only). Free key from https://api-v3.mbta.com. Strongly recommended:
# without it the limit is 20 requests/min and live arrivals will fall back to canned data.
MBTA_API_KEY=

# Solana devnet (server only). Base58 secret key of the badge/memo wallet.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=
