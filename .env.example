# Demo mode: works with NO other keys set. Fake users, canned responses, simulate button.
NEXT_PUBLIC_DEMO_MODE=true

# Firebase (client, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only, only to verify ID tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Tiger Data (server only). Postgres connection string from Tiger Cloud.
DATABASE_URL=

# Google (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_ROUTES_API_KEY=

# MBTA V3 (server only, optional, raises rate limit)
MBTA_API_KEY=

# Solana devnet (server only). Base58 secret key of the badge/memo wallet.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=
